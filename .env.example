# Copy this file to .env and fill in your own Supabase project's values.
# Both of these are the PUBLIC anon key/URL - safe to expose in client code
# (Supabase enforces access via Row Level Security, not by hiding this key).
# Never put the "service_role" key here or in any client-side file.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
